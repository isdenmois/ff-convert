{
  "name": "ffconvert-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && touch dist/.gitkeep",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p e2e",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ffconvert/shared": "workspace:*",
    "pinia": "^4.0.3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "lefthook": "^2.2.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^2.2.4",
    "ws": "^8.22.0"
  }
}
